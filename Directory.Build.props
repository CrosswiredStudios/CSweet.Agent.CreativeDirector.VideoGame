<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <CSweetAgentSdkRepositoryRoot Condition="'$(CSweetAgentSdkRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweetAgentSdk</CSweetAgentSdkRepositoryRoot>
    <UseLocalCSweetAgentSdk Condition="'$(UseLocalCSweetAgentSdk)' == '' and Exists('$(CSweetAgentSdkRepositoryRoot)\src\CSweet.Agent.SDK\CSweet.Agent.SDK.csproj')">true</UseLocalCSweetAgentSdk>
    <UseLocalCSweetAgentSdk Condition="'$(UseLocalCSweetAgentSdk)' == ''">false</UseLocalCSweetAgentSdk>
    <CSweetMemoryRepositoryRoot Condition="'$(CSweetMemoryRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweet.Memory</CSweetMemoryRepositoryRoot>
    <UseLocalCSweetMemory Condition="'$(UseLocalCSweetMemory)' == '' and Exists('$(CSweetMemoryRepositoryRoot)\src\CSweet.Memory\CSweet.Memory.csproj')">true</UseLocalCSweetMemory>
    <UseLocalCSweetMemory Condition="'$(UseLocalCSweetMemory)' == ''">false</UseLocalCSweetMemory>
    <CSweetVideoGameRepositoryRoot Condition="'$(CSweetVideoGameRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)</CSweetVideoGameRepositoryRoot>
    <UseLocalVideoGameContracts Condition="'$(UseLocalVideoGameContracts)' == '' and Exists('$(CSweetVideoGameRepositoryRoot)\src\CSweet.VideoGame.Contracts\CSweet.VideoGame.Contracts.csproj')">true</UseLocalVideoGameContracts>
    <UseLocalVideoGameContracts Condition="'$(UseLocalVideoGameContracts)' == ''">false</UseLocalVideoGameContracts>
    <UseLocalVideoGameAgentKit Condition="'$(UseLocalVideoGameAgentKit)' == '' and Exists('$(CSweetVideoGameRepositoryRoot)\src\CSweet.VideoGame.AgentKit\CSweet.VideoGame.AgentKit.csproj')">true</UseLocalVideoGameAgentKit>
    <UseLocalVideoGameAgentKit Condition="'$(UseLocalVideoGameAgentKit)' == ''">false</UseLocalVideoGameAgentKit>
  </PropertyGroup>
</Project>
