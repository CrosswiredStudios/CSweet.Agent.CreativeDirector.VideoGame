<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.3.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CSweet.Agent.SDK" Version="3.23.0" Condition="'$(UseLocalCSweetAgentSdk)' != 'true'" />
    <PackageReference Include="CSweet.Memory" Version="0.1.2" Condition="'$(UseLocalCSweetMemory)' != 'true'" />
    <PackageReference Include="CSweet.Memory.Broker" Version="0.1.2" Condition="'$(UseLocalCSweetMemory)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CSweet.Agent.CreativeDirector.VideoGame.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalCSweetAgentSdk)' == 'true'">
    <ProjectReference Include="$(CSweetAgentSdkRepositoryRoot)\src\CSweet.Agent.SDK\CSweet.Agent.SDK.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalCSweetMemory)' == 'true'">
    <ProjectReference Include="$(CSweetMemoryRepositoryRoot)\src\CSweet.Memory\CSweet.Memory.csproj" />
    <ProjectReference Include="$(CSweetMemoryRepositoryRoot)\src\CSweet.Memory.Broker\CSweet.Memory.Broker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <Content Include="..\..\csweet-plugin.json" Link="csweet-plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
